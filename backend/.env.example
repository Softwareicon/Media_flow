# ---- Copy to .env and fill in. NEVER commit a real .env. ----
ENVIRONMENT=development            # development | production
DATABASE_URL=postgresql+asyncpg://mediaflow:mediaflow@localhost:5432/mediaflow
PUBLIC_BASE_URL=http://localhost:8000   # production: https://api.yourdomain.com (used for OAuth redirect URIs)
REQUIRE_HTTPS=false                 # production: true
FORWARDED_ALLOW_IPS=127.0.0.1       # production: your reverse proxy's address range (never *)
APP_REDIRECT_SCHEME=mediaflow
AUTO_CREATE_TABLES=false            # keep false; use `alembic upgrade head`

# Fernet key for encrypting stored OAuth tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Limits
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_AUTH_PER_MINUTE=10
MAX_MEDIA_BYTES=4294967296
ANALYSIS_TTL_SECONDS=900
DOWNLOAD_RECORD_RETENTION_DAYS=30

# ---- Platform credentials (all optional; leave blank and the platform reports "not configured") ----
YOUTUBE_API_KEY=                    # optional: adds video duration to previews
VIMEO_CLIENT_ID=
VIMEO_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v21.0
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
REDDIT_CLIENT_ID=                   # requires Reddit's explicit API approval
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=server:mediaflow-pro:1.0 (by /u/your_reddit_username)
X_BEARER_TOKEN=
X_MEDIA_DOWNLOADS_ENABLED=false     # set true only after confirming your X developer agreement permits it
